services:
  solana_exporter:
    container_name: solana_exporter
    image: mcamou/solana-exporter:b8fcc7c170049d5c9c34ea57b9f2fcb3a0b5044d
    network_mode: "host"
    volumes:
      - "/home/devops/solana-exporter/data:/root"
      - "/home/devops/solana-exporter/exporter:/exporter"
    command:
      - "--rpcURI"
      - "http://localhost:8899/"
      - "-votepubkey"
      - "{{ vote_account_pubkey }}"
      - "-addr"
      - ":9999"
    restart: always
