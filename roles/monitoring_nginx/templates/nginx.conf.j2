events {
    worker_connections 1024;
}

http {
    keepalive_timeout 65;
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;

    # Redirect HTTP to HTTPS
    server {
        listen 80;
        server_name {{ grafana_subdomain }} {{ prometheus_subdomain }} {{ alertmanager_subdomain }};

        location /.well-known/acme-challenge/ {
            root {{ webroot_dir }};
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # Grafana Subdomain (HTTPS)
    server {
        listen 443 ssl;
        server_name {{ grafana_subdomain }};

        ssl_certificate /etc/letsencrypt/live/{{ grafana_subdomain }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ grafana_subdomain }}/privkey.pem;

        location / {
            proxy_pass {{ grafana_proxy_pass }}; # Ensure the protocol is correct
            proxy_set_header Host $host;
        }
    }

    # Prometheus Subdomain (HTTPS)
    server {
        listen 443 ssl;
        server_name {{ prometheus_subdomain }};

        ssl_certificate /etc/letsencrypt/live/{{ prometheus_subdomain }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ prometheus_subdomain }}/privkey.pem;

# Prometheus already deployed with basic_auth enabled
#        auth_basic "Restricted Access";
#        auth_basic_user_file /etc/nginx/prometheus.htpasswd;

        location / {
            proxy_pass {{ prometheus_proxy_pass }}; # Corrected to http
            proxy_set_header Host $host;
        }
    }

    # Alertmanager Subdomain (HTTPS)
    server {
        listen 443 ssl;
        server_name {{ alertmanager_subdomain }};

        ssl_certificate /etc/letsencrypt/live/{{ alertmanager_subdomain }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ alertmanager_subdomain }}/privkey.pem;

        auth_basic "Restricted Access";
        auth_basic_user_file /etc/nginx/alertmanager.htpasswd;

        location / {
            proxy_pass {{ alertmanager_proxy_pass }}; # Corrected to http
            proxy_set_header Host $host;
        }
    }
}
