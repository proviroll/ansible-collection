#!/bin/bash

# Variables
domains=("$@")  # Captures argument passed to the script (e.g : 'grafana.proviroll.xyz')
rsa_key_size=4096
data_path="{{ certbot_cert_dir }}"
email="{{ cloudflare_email }}" # Replace with your email
staging={{ staging }}  # Set to 1 for testing mode, 0 for production

echo "### Current user: $(whoami)"

# Check if existing data exists and prompt to overwrite
if [ -d "$data_path/live/${domains[0]}" ]; then
  read -p "Existing data found for ${domains[*]}. Continue and replace existing certificate? (y/N) " decision
  if [ "$decision" != "Y" ] && [ "$decision" != "y" ]; then
    exit
  fi
fi

# Create a dummy certificate for all domains
for domain in "${domains[@]}"; do
  echo "### Creating dummy certificate for $domain ..."
  mkdir -p "$data_path/live/$domain"
  docker-compose run --rm --entrypoint "\
    openssl req -x509 -nodes -newkey rsa:$rsa_key_size -days 1 \
      -keyout '/etc/letsencrypt/live/$domain/privkey.pem' \
      -out '/etc/letsencrypt/live/$domain/fullchain.pem' \
      -subj '/CN=localhost'" certbot
done
echo

# Start NGINX to serve the HTTP-01 challenge
echo "### Starting nginx ..."
docker-compose up -d nginx
echo

# Remove dummy certificates
for domain in "${domains[@]}"; do
  echo "### Deleting dummy certificate for $domain ..."
  docker-compose run --rm --entrypoint "\
    rm -Rf /etc/letsencrypt/live/$domain && \
    rm -Rf /etc/letsencrypt/archive/$domain && \
    rm -Rf /etc/letsencrypt/renewal/$domain.conf" certbot
done
echo

# Request a Let's Encrypt certificate for all domains
echo "### Requesting Let's Encrypt certificates for ${domains[*]}..."
domain_args=""
for domain in "${domains[@]}"; do
  domain_args="$domain_args -d $domain"
done

email_arg="--register-unsafely-without-email"
if [ -n "$email" ]; then
  email_arg="--email $email"
fi

staging_arg=""
if [ $staging -eq 1 ]; then
  staging_arg="--staging"
fi

docker-compose run --rm --entrypoint "\
  certbot certonly --webroot -w /var/www/certbot \
    $staging_arg \
    $email_arg \
    $domain_args \
    --rsa-key-size $rsa_key_size \
    --agree-tos \
    --force-renewal" certbot
echo

# Reload NGINX to apply new certificates
echo "### Reloading nginx ..."
docker-compose exec nginx nginx -s reload
